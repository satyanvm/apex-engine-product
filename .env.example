# Postgres. Managed providers: append ?sslmode=require
DATABASE_URL=postgres://apex:change-me@localhost:5432/apex_flows

# The apex-engine deployment this product talks to. Server-side only; the
# browser never sees either value.
ENGINE_URL=http://localhost:8091
ENGINE_API_KEY=replace-with-a-key-from-APEX_API_KEYS

# Public origin of this app, no trailing slash. Mutating requests must come
# from this origin, and an https:// value turns on Secure cookies.
APP_URL=http://localhost:3100

# Monthly limits per workspace. A workspace row can override them.
MONTHLY_COMPILE_LIMIT=100
MONTHLY_RUN_LIMIT=500
